/-!
# Kummer theory for affine curves

Mochizuki, *Topics in Absolute Anabelian Geometry III*, Proposition 1.6 (i): for a hyperbolic
curve over a Kummer-faithful field `k`, the Kummer map
`κ_U : Γ(U, 𝒪_U^×) → H¹(Π_U, Ẑ(1))` is injective.

## Setting

We use the Galois-theoretic model of the étale fundamental group from `pi1`
(`Pi1.Orbifold.GaloisData`, SGA 1 V.8.2): `k` a field of characteristic `0`, `Ω` a separably
closed field, Galois over `K₀ = k(t)` (`t` transcendental), and `D : GaloisData k t`: open
subgroups `H_L ≤ H` of `Gal(Ω / K₀)`, `H` normalizing `H_L`. Then

* `F = Ω^H` (`Curve.F D`) is the function field of the coarse curve `U = Spec R^A`, where `R` is
  the integral closure of `k[t]` in `L = Ω^{H_L}` and `A = H ⧸ H_L`;
* `Π_U = H ⧸ ⟨⟨S⟩⟩` (`GaloisPi1.pi1 D.H D.S`), the quotient by the closed normal subgroup
  generated by the inertia groups `S` of the places of `Ω` centered on `Spec R`; by
  `Pi1.Orbifold.GaloisData.equivPi1` this is the étale fundamental group `etalePi1 R A Ω` of
  `[Spec R / A]` (for `H = H_L`, i.e. `A` trivial: of the affine curve `Spec R`);
* `Γ(U, 𝒪^×)` is `Curve.units D`: the elements `u ∈ Fˣ` with `u` and `u⁻¹` integral over `k[t]`
  (for `A` trivial: the units of `R`).

## Main definitions

* `Curve.kernelActsTrivially`, and the induced actions of `Π_U` on `μ_n(Ω)` and on
  `Ẑ(1) = lim μ_n(Ω)`: the inertia groups at places centered on `U` act trivially on roots of
  unity (residue characteristic `0`).
* `Curve.toGalF D : H →* Gal(Ω / F)`, continuous and surjective.
* `Curve.kummerMap D n : Curve.units D →* H¹_cont(Π_U, μ_n)` and
  `Curve.kummerMapZHat D : Curve.units D →* H¹_cont(Π_U, Ẑ(1))`: the Kummer maps of `U`.
  They are characterised by their inflations to `H`, which are the restrictions of the Kummer
  classes of the function field (`Curve.inflation_kummerMap`, `Curve.inflation_kummerMapZHat`):
  the Kummer extensions `F(u^{1/n})` of a unit `u` of `U` are unramified over `U`.

## Main results

* `KummerTheory.kummerZHat_injective_iff`: for a field `K` of characteristic `0`, the Kummer map
  `Kˣ → H¹(G_K, Ẑ(1))` is injective iff `K` is Kummer-faithful for `𝔾_m`
  ([AbsTopIII] Def. 1.5, (a) ⇔ (b), for `𝔾_m`).
* `Curve.inflation_kummerMap`, `Curve.inflation_kummerMapZHat`, `Curve.map_proj_kummerMapZHat`:
  compatibility with the Kummer maps of the function field and between `Ẑ(1)` and `μ_n`.
* `Curve.kummerMapZHat_injective`: **[AbsTopIII] Prop. 1.6(i)** — if `k` is Kummer-faithful for
  `𝔾_m` and algebraically closed in `F`, then `κ_U : Γ(U, 𝒪^×) → H¹(Π_U, Ẑ(1))` is injective.
-/

universe u

open groupCohomology AffOrbicurve IntermediateField IntermediateField.algebraAdjoinAdjoin

namespace KummerTheory

section Field

variable (K Ω : Type*) [Field K] [Field Ω] [Algebra K Ω] [IsGalois K Ω] [IsSepClosed Ω]
  [CharZero K]

/-- **[AbsTopIII] Definition 1.5, (a) ⇔ (b), for `𝔾_m`**: the Kummer map
`Kˣ → H¹(G_K, Ẑ(1))` is injective iff `⋂_N (Kˣ)^N = {1}` (characteristic `0`). -/
theorem kummerZHat_injective_iff :
    Function.Injective (kummerZHat K Ω) ↔ IsKummerFaithfulGm K := by
  rw [injective_iff_map_eq_one]
  constructor
  · intro h a ha
    refine h a ?_
    apply h1ToLimit_injective K Ω
    rw [map_one]
    apply Subtype.ext
    funext i
    change h1Proj K Ω i (kummerZHat K Ω a) = 1
    rw [h1Proj_kummerZHat, ← MonoidHom.mem_ker, ker_kummer]
    obtain ⟨y, hy⟩ := ha i.n (Nat.pos_of_ne_zero i.n_ne_zero)
    exact ⟨y, hy⟩
  · intro h a ha
    refine h a fun n hn => ?_
    haveI : NeZero (n : K) := ⟨Nat.cast_ne_zero.mpr hn.ne'⟩
    have h3 := h1Proj_kummerZHat K Ω ⟨n, Nat.cast_ne_zero.mpr hn.ne'⟩ a
    rw [ha, map_one] at h3
    have hker : a ∈ (kummer n K Ω).ker := h3.symm
    rw [ker_kummer] at hker
    obtain ⟨y, hy⟩ := hker
    exact ⟨y, hy⟩

end Field

namespace Curve

section Local

variable {P Ω : Type u} [Field P] [Field Ω] [Algebra P Ω]

/-- An element `x` of a valuation subring with `x⁻¹` also in it has valuation `1`. -/
theorem valuation_eq_one_of_mem {W : ValuationSubring Ω} {x : Ω} (hx : x ∈ W) (hx' : x⁻¹ ∈ W)
    (h0 : x ≠ 0) : W.valuation x = 1 := by
  have h1 := (W.valuation_le_one_iff x).mpr hx
  have h2 := (W.valuation_le_one_iff _).mpr hx'
  have h3 : W.valuation x * W.valuation x⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ h0, map_one]
  refine le_antisymm h1 ?_
  by_contra h
  have := mul_lt_one_of_lt_of_le (not_le.mp h) h2
  rw [h3] at this
  exact lt_irrefl _ this

/-- A valuation subring is closed under `n`-th roots. -/
theorem mem_of_pow_mem {W : ValuationSubring Ω} {x : Ω} {n : ℕ} (hn : 0 < n) (hx : x ^ n ∈ W) :
    x ∈ W := by
  have hint : IsIntegral W x := by
    refine IsIntegral.of_pow hn ?_
    have : x ^ n = algebraMap W Ω ⟨x ^ n, hx⟩ := rfl
    rw [this]
    exact isIntegral_algebraMap
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  rw [← hy]
  exact y.2

/-- **Inertia acts trivially on roots of `W`-units of order prime to the residue
characteristic.** Let `W` be a valuation subring of `Ω` containing a field `k` of characteristic
`0`, `σ` in the inertia group of `W`, and `x` a `W`-unit with `σ x = ζ x` for an `n`-th root of
unity `ζ`. Then `σ x = x`: the residue of `ζ` is `1`, and `ζ ↦ ζ̄` is injective on roots of
unity in residue characteristic `0`. -/
theorem eq_of_mem_inertia {k : Type*} [Field k] [CharZero k] [Algebra k Ω]
    {W : ValuationSubring Ω} (hk : ∀ c : k, algebraMap k Ω c ∈ W) {σ : Ω ≃ₐ[P] Ω}
    (hσ : σ ∈ GaloisPi1.inertia W) {x ζ : Ω} (hx : x ∈ W) (hvx : W.valuation x = 1) {n : ℕ}
    (hn : 0 < n) (hζ : ζ ^ n = 1) (hσx : σ x = ζ * x) : σ x = x := by
  have h1 : W.valuation (ζ - 1) < 1 := by
    have := (show ∀ a ∈ W, W.valuation (σ a - a) < 1 from hσ) x hx
    rwa [hσx, ← sub_one_mul, map_mul, hvx, mul_one] at this
  by_contra hne
  have hζ1 : ζ - 1 ≠ 0 := by
    intro h
    apply hne
    rw [hσx, sub_eq_zero.mp h, one_mul]
  have hζW : ζ ∈ W := by
    have : ζ = (ζ - 1) + 1 := by ring
    rw [this]
    exact W.add_mem _ _ ((W.valuation_le_one_iff _).mp h1.le) W.one_mem
  have hsum : ∑ i ∈ Finset.range n, ζ ^ i = 0 := by
    have := geom_sum_mul ζ n
    rw [hζ, sub_self] at this
    exact (mul_eq_zero.mp this).resolve_right hζ1
  have hn' : (n : Ω) = ∑ i ∈ Finset.range n, (1 - ζ ^ i) := by
    rw [Finset.sum_sub_distrib, hsum, sub_zero]
    simp
  have hlt : W.valuation (n : Ω) < 1 := by
    rw [hn']
    refine Valuation.map_sum_lt _ one_ne_zero fun i _ => ?_
    have hg : ∑ j ∈ Finset.range i, ζ ^ j ∈ W :=
      W.sum_mem fun j _ => W.pow_mem hζW j
    have : 1 - ζ ^ i = -((∑ j ∈ Finset.range i, ζ ^ j) * (ζ - 1)) := by
      rw [geom_sum_mul]; ring
    rw [this, Valuation.map_neg, map_mul]
    calc W.valuation (∑ j ∈ Finset.range i, ζ ^ j) * W.valuation (ζ - 1)
        ≤ 1 * W.valuation (ζ - 1) :=
          mul_le_mul_left ((W.valuation_le_one_iff _).mpr hg) _
      _ < 1 := by rwa [one_mul]
  have hn0 : (n : k) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have heq : W.valuation (n : Ω) = 1 := by
    have hnk : (n : Ω) = algebraMap k Ω n := (map_natCast _ n).symm
    refine valuation_eq_one_of_mem ?_ ?_ ?_
    · rw [hnk]; exact hk _
    · rw [hnk, ← map_inv₀]; exact hk _
    · rw [hnk]; exact (map_ne_zero _).mpr hn0
  rw [heq] at hlt
  exact lt_irrefl _ hlt

end Local

section Global

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : Pi1.Orbifold.GaloisData k t)

/-- The function field `F = Ω^H` of the (coarse) curve `U`. -/
abbrev F : IntermediateField (K₀ k t) Ω := IntermediateField.fixedField D.H

/-- The fundamental group `Π_U = H ⧸ ⟨⟨S⟩⟩` (the underlying group of
`GaloisPi1.pi1 D.H D.S D.isClosed_H`). -/
abbrev Pi : Type u := D.H ⧸ GaloisPi1.kernel D.H D.S

/-- **`Γ(U, 𝒪_U^×)`**: the units `u` of `F` with `u` and `u⁻¹` integral over `k[t]` (for `A`
trivial, i.e. `H = H_L`: the units of the coordinate ring `R` of `U`). -/
def units : Subgroup (F D)ˣ where
  carrier := {u | IsIntegral (A₀ k t) (u : F D) ∧ IsIntegral (A₀ k t) ((u⁻¹ : (F D)ˣ) : F D)}
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨by simpa using ha.mul hb, ?_⟩
    rw [mul_inv_rev, Units.val_mul]
    exact hb'.mul ha'
  one_mem' := ⟨by simpa using isIntegral_one, by simpa using isIntegral_one⟩
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    exact ⟨ha', by simpa using ha⟩

variable {D}

/-- Elements of `Γ(U, 𝒪^×)` are units of every valuation subring centered on `U`. -/
theorem units_mem {W : ValuationSubring Ω} (hW : IsCentered k t W) {u : (F D)ˣ}
    (hu : u ∈ units D) : ((u : F D) : Ω) ∈ W ∧ (((u⁻¹ : (F D)ˣ) : F D) : Ω) ∈ W :=
  ⟨toΩ_mem hW (F D) ⟨_, hu.1⟩, toΩ_mem hW (F D) ⟨_, hu.2⟩⟩

theorem fixes_of_mem_F {h : Ω ≃ₐ[K₀ k t] Ω} (hh : h ∈ D.H) (x : F D) : h (x : Ω) = x :=
  (IntermediateField.mem_fixedField_iff _ _).mp x.2 h hh

/-- **Inertia at places centered on `U` fixes the roots of units of `U`.** -/
theorem eq_of_mem_S [CharZero k] {s : Ω ≃ₐ[K₀ k t] Ω} (hs : s ∈ D.S) {u : (F D)ˣ}
    (hu : u ∈ units D) {γ : Ω} {n : ℕ} (hn : 0 < n) (hγ : γ ^ n = ((u : F D) : Ω)) : s γ = γ := by
  obtain ⟨hsHL, W, hk, htW, hinert⟩ := hs
  have hsH : s ∈ D.H := D.le hsHL
  have hγ0 : γ ≠ 0 := by
    rintro rfl
    rw [zero_pow hn.ne'] at hγ
    exact u.ne_zero (Subtype.ext hγ.symm)
  have huW := units_mem ⟨hk, htW⟩ hu
  have hγW : γ ∈ W := mem_of_pow_mem hn (hγ ▸ huW.1)
  have hγW' : γ⁻¹ ∈ W := by
    refine mem_of_pow_mem hn ?_
    rw [inv_pow, hγ]
    convert huW.2 using 1
    simp
  have hv := valuation_eq_one_of_mem hγW hγW' hγ0
  have hpow : (s γ / γ) ^ n = 1 := by
    rw [div_pow, ← map_pow, hγ, fixes_of_mem_F hsH, div_self]
    exact fun h => u.ne_zero (Subtype.ext (by simp at h))
  refine eq_of_mem_inertia (k := k) hk hinert hγW hv hn hpow ?_
  field_simp

variable [IsGalois (K₀ k t) Ω]

/-- **The closed normal subgroup generated by the inertia groups fixes the roots of units of
`U`.** -/
theorem eq_of_mem_ambientKernel [CharZero k] {σ : Ω ≃ₐ[K₀ k t] Ω}
    (hσ : σ ∈ GaloisPi1.ambientKernel D.H D.S) {u : (F D)ˣ} (hu : u ∈ units D) {γ : Ω} {n : ℕ}
    (hn : 0 < n) (hγ : γ ^ n = ((u : F D) : Ω)) : σ γ = γ := by
  let St := MulAction.stabilizer (Ω ≃ₐ[K₀ k t] Ω) γ
  have hcl : IsClosed (St : Set (Ω ≃ₐ[K₀ k t] Ω)) :=
    Subgroup.isClosed_of_isOpen _ (stabilizer_isOpen_of_isIntegral γ)
  have hle : GaloisPi1.ambientKernel D.H D.S ≤ St := by
    refine Subgroup.topologicalClosure_minimal _ ?_ hcl
    rw [Subgroup.closure_le]
    rintro _ ⟨h, hh, s, hs, rfl⟩
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
    have hγ' : (h⁻¹ γ) ^ n = ((u : F D) : Ω) := by
      rw [← map_pow, hγ]
      exact fixes_of_mem_F (D.H.inv_mem hh) u
    simp only [AlgEquiv.mul_apply]
    rw [eq_of_mem_S hs hu hn hγ']
    exact h.apply_symm_apply γ
  exact hle hσ

/-- Elements of `⟨⟨S⟩⟩` fix all roots of unity. -/
theorem eq_of_mem_kernel_of_pow_eq_one [CharZero k] {σ : D.H}
    (hσ : σ ∈ GaloisPi1.kernel D.H D.S) {ζ : Ω} {n : ℕ} (hn : 0 < n) (hζ : ζ ^ n = 1) :
    (σ : Ω ≃ₐ[K₀ k t] Ω) ζ = ζ :=
  eq_of_mem_ambientKernel hσ (units D).one_mem hn (by simpa using hζ)

/-- `⟨⟨S⟩⟩` acts trivially on `μ_n(Ω)` (`n ≠ 0`). -/
theorem kernel_smul_mu [CharZero k] (n : ℕ) [NeZero n] :
    ∀ σ ∈ GaloisPi1.kernel D.H D.S, ∀ ζ : Mu n Ω, σ • ζ = ζ := by
  intro σ hσ ζ
  apply Mu.ext
  apply Units.ext
  exact eq_of_mem_kernel_of_pow_eq_one hσ (Nat.pos_of_ne_zero (NeZero.ne n))
    (by rw [← Units.val_pow_eq_pow_val, Mu.val_pow_n, Units.val_one])

/-- `⟨⟨S⟩⟩` acts trivially on `Ẑ(1)`. -/
theorem kernel_smul_zHatOne [CharZero k] (K : Type*) [Field K] :
    ∀ σ ∈ GaloisPi1.kernel D.H D.S, ∀ x : ZHatOne K Ω, σ • x = x := by
  intro σ hσ x
  apply Subtype.ext
  funext i
  exact kernel_smul_mu i.n σ hσ _

/-- The action of `Π_U` on `μ_n(Ω)`. -/
instance instMulDistribMulActionMu [CharZero k] (n : ℕ) [NeZero n] :
    MulDistribMulAction (Pi D) (Mu n Ω) :=
  MulDistribMulAction.quotientOfLeKer _ (kernel_smul_mu n)

/-- The action of `Π_U` on `Ẑ(1)`. -/
instance instMulDistribMulActionZHatOne [CharZero k] (K : Type*) [Field K] :
    MulDistribMulAction (Pi D) (ZHatOne K Ω) :=
  MulDistribMulAction.quotientOfLeKer _ (kernel_smul_zHatOne K)

end Global

section Restriction

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : Pi1.Orbifold.GaloisData k t)

/-- The isomorphism `H ≅ Gal(Ω / F)` (as a homomorphism; `H` is closed, so it is the fixing
group of `F = Ω^H`). -/
def toGalF : D.H →* (Ω ≃ₐ[F D] Ω) where
  toFun h := AlgEquiv.ofRingEquiv (f := (h : Ω ≃ₐ[K₀ k t] Ω).toRingEquiv)
    fun x => fixes_of_mem_F h.2 x
  map_one' := by ext; rfl
  map_mul' _ _ := by ext; rfl

variable {D}

@[simp]
theorem toGalF_apply (h : D.H) (x : Ω) : toGalF D h x = (h : Ω ≃ₐ[K₀ k t] Ω) x := rfl

theorem toGalF_smul_mu {n : ℕ} (h : D.H) (ζ : Mu n Ω) : toGalF D h • ζ = h • ζ := rfl

theorem toGalF_smul_zHatOne {K : Type*} [Field K] (h : D.H) (x : ZHatOne K Ω) :
    toGalF D h • x = h • x := rfl

variable [IsGalois (K₀ k t) Ω]

open scoped Topology in
theorem continuous_toGalF : Continuous (toGalF D) := by
  refine continuous_of_continuousAt_one _ ?_
  intro V hV
  rw [map_one] at hV
  obtain ⟨E, hE, hEV⟩ := (krullTopology_mem_nhds_one_iff (F D) Ω V).1 hV
  obtain ⟨T, hTfin, hadj⟩ := IntermediateField.fg_def.1 (E.fg_of_fg_toSubalgebra
    (Subalgebra.fg_of_fg_toSubmodule ((Submodule.fg_iff_finiteDimensional _).2 hE)))
  have hmem : (⋂ x ∈ T, ((Subgroup.subtype D.H) ⁻¹'
      (MulAction.stabilizer (Ω ≃ₐ[K₀ k t] Ω) x : Set (Ω ≃ₐ[K₀ k t] Ω)))) ∈ 𝓝 (1 : D.H) :=
    (Filter.biInter_mem hTfin).2 fun x _ =>
      ((stabilizer_isOpen_of_isIntegral x).preimage continuous_subtype_val).mem_nhds (by simp)
  refine Filter.mem_map.2 (Filter.mem_of_superset hmem fun σ hσ => hEV ?_)
  simp only [Set.mem_iInter, Set.mem_preimage, Subgroup.coe_subtype, SetLike.mem_coe,
    MulAction.mem_stabilizer_iff] at hσ
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff, ← hadj]
  exact (forall_mem_adjoin_smul_eq_self_iff (F D) (S := T) (toGalF D σ)).2 fun x hx => hσ x hx

theorem toGalF_surjective : Function.Surjective (toGalF D) := by
  intro τ
  have hmem : τ.restrictScalars (K₀ k t) ∈ D.H := by
    have e : (fixedField D.H).fixingSubgroup = D.H :=
      InfiniteGalois.fixingSubgroup_fixedField ⟨D.H, D.isClosed_H⟩
    rw [← e]
    exact fun x => τ.commutes x
  exact ⟨⟨_, hmem⟩, by ext; rfl⟩

/-- **Restriction** `H¹(Gal(Ω / F), M) → H¹(H, M)` along `H ≅ Gal(Ω / F)`. -/
noncomputable def res {M : Type*} [CommGroup M] [TopologicalSpace M] [IsTopologicalGroup M]
    [MulDistribMulAction (Ω ≃ₐ[F D] Ω) M] [MulDistribMulAction D.H M]
    (hcomp : ∀ (h : D.H) (m : M), toGalF D h • m = h • m) :
    ContH1 (Ω ≃ₐ[F D] Ω) M →* ContH1 D.H M :=
  ContH1.map (toGalF D) continuous_toGalF (MonoidHom.id M) continuous_id hcomp

theorem res_injective {M : Type*} [CommGroup M] [TopologicalSpace M] [IsTopologicalGroup M]
    [MulDistribMulAction (Ω ≃ₐ[F D] Ω) M] [MulDistribMulAction D.H M]
    (hcomp : ∀ (h : D.H) (m : M), toGalF D h • m = h • m) :
    Function.Injective (res hcomp) := by
  rw [injective_iff_map_eq_one]
  intro x hx
  induction x using ContH1.induction_on with
  | h c =>
    rw [res, ContH1.map_mk, ContH1.mk_eq_one_iff] at hx
    obtain ⟨m, hm⟩ := hx
    rw [ContH1.mk_eq_one_iff]
    refine ⟨m, fun τ => ?_⟩
    obtain ⟨h, rfl⟩ := toGalF_surjective τ
    rw [hcomp]
    exact hm h

variable (D) in
/-- Restriction with coefficients `μ_n`. -/
noncomputable abbrev resMu (n : ℕ) : ContH1 (Ω ≃ₐ[F D] Ω) (Mu n Ω) →* ContH1 D.H (Mu n Ω) :=
  res (M := Mu n Ω) fun _ _ => rfl

variable (D) in
/-- Restriction with coefficients `Ẑ(1)`. -/
noncomputable abbrev resZHat (K : Type*) [Field K] :
    ContH1 (Ω ≃ₐ[F D] Ω) (ZHatOne K Ω) →* ContH1 D.H (ZHatOne K Ω) :=
  res (M := ZHatOne K Ω) fun _ _ => rfl

end Restriction

section KummerMap

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : Pi1.Orbifold.GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω]

instance charZero_F : CharZero (F D) :=
  charZero_of_injective_algebraMap (algebraMap k (F D)).injective

instance isGalois_F : IsGalois (F D) Ω := IsGalois.tower_top_of_isGalois (K₀ k t) (F D) Ω

variable {D}

omit [IsSepClosed Ω] in
theorem pi_smul_mu {n : ℕ} [NeZero n] (h : D.H) (ζ : Mu n Ω) : (h : Pi D) • ζ = h • ζ := rfl

omit [IsSepClosed Ω] in
theorem pi_smul_zHatOne {K : Type*} [Field K] (h : D.H) (x : ZHatOne K Ω) :
    (h : Pi D) • x = h • x := rfl

omit [IsSepClosed Ω] in
theorem proj_pi_smul {K : Type*} [Field K] (i : KummerIndex K) (g : Pi D) (x : ZHatOne K Ω) :
    ZHatOne.proj i (g • x) = g • ZHatOne.proj i x := by
  induction g using QuotientGroup.induction_on with
  | H h => rfl

variable (D) in
/-- Inflation from `Π_U` to `H`, coefficients `μ_n`. -/
noncomputable abbrev inflMu (n : ℕ) [NeZero n] : ContH1 (Pi D) (Mu n Ω) →* ContH1 D.H (Mu n Ω) :=
  ContH1.inflation (M := Mu n Ω) (GaloisPi1.kernel D.H D.S) fun _ _ => rfl

variable (D) in
/-- Inflation from `Π_U` to `H`, coefficients `Ẑ(1)`. -/
noncomputable abbrev inflZHat (K : Type*) [Field K] :
    ContH1 (Pi D) (ZHatOne K Ω) →* ContH1 D.H (ZHatOne K Ω) :=
  ContH1.inflation (M := ZHatOne K Ω) (GaloisPi1.kernel D.H D.S) fun _ _ => rfl

/-- The restriction to `H` of the `μ_n`-valued Kummer class of a unit of `U` has a representative
(the Kummer cocycle `σ ↦ σ(u^{1/n}) / u^{1/n}`) which is trivial on `⟨⟨S⟩⟩`: the Kummer extension
is unramified over `U`. -/
theorem exists_trivial_kummer (n : ℕ) [NeZero n] (u : units D) :
    ∃ c : ContH1.cocycles D.H (Mu n Ω),
      ContH1.mk c = resMu D n (kummer n (F D) Ω u) ∧
        ∀ σ ∈ GaloisPi1.kernel D.H D.S, c σ = 1 := by
  set α := kummerRoot n (F D) Ω (u : (F D)ˣ)
  have hα : ((α : Ω)) ^ n = (((u : (F D)ˣ) : F D) : Ω) := by
    have := congrArg (fun x : Ωˣ => (x : Ω)) (kummerRoot_pow n (F D) Ω (u : (F D)ˣ))
    simpa using this
  refine ⟨ContH1.cocyclesMap (toGalF D) continuous_toGalF (MonoidHom.id _) continuous_id
    (fun _ _ => rfl) (kummerCocycle α (smul_pow_of_pow_eq (kummerRoot_pow n (F D) Ω _))),
    rfl, fun σ hσ => ?_⟩
  have hfix : (σ : Ω ≃ₐ[K₀ k t] Ω) (α : Ω) = α :=
    eq_of_mem_ambientKernel hσ u.2 (Nat.pos_of_ne_zero (NeZero.ne n)) hα
  apply Mu.ext
  apply Units.ext
  simp only [ContH1.cocyclesMap_apply, MonoidHom.id_apply, kummerCocycle_apply, val_kummerFun,
    Units.val_div_eq_div_val, AlgEquiv.smul_units_def, Units.coe_map,
    MonoidHom.coe_coe, toGalF_apply]
  simp [hfix, α.ne_zero]

variable (D) in
/-- **The `μ_n`-valued Kummer map of `U`**, `κ_U : Γ(U, 𝒪^×) → H¹_cont(Π_U, μ_n)`. -/
noncomputable def kummerMap (n : ℕ) [NeZero n] : units D →* ContH1 (Pi D) (Mu n Ω) :=
  ContH1.descendHom (fun _ _ => rfl)
    ((resMu D n).comp ((kummer n (F D) Ω).comp (units D).subtype))
    (exists_trivial_kummer n)

/-- The inflation of `κ_U(u)` to `H ≅ Gal(Ω / F)` is the Kummer class of `u` in the function
field. -/
theorem inflation_kummerMap (n : ℕ) [NeZero n] (u : units D) :
    inflMu D n (kummerMap D n u) =
      resMu D n (kummer n (F D) Ω u) :=
  ContH1.inflation_descendHom _ _ _ u

omit [CharZero k] in
/-- The components of the restricted `Ẑ(1)`-valued Kummer class are the restricted `μ_n`-valued
Kummer classes. -/
theorem map_proj_res_kummerZHat (i : KummerIndex (F D)) (u : (F D)ˣ) :
    ContH1.map (MonoidHom.id D.H) continuous_id (ZHatOne.proj i) (ZHatOne.continuous_proj i)
      (fun _ _ => rfl) (resZHat D (F D) (kummerZHat (F D) Ω u)) =
      resMu D i.n (kummer i.n (F D) Ω u) := by
  rw [← h1Proj_kummerZHat]
  induction kummerZHat (F D) Ω u using ContH1.induction_on with
  | h c => rfl

theorem exists_trivial_kummerZHat (u : units D) :
    ∃ c : ContH1.cocycles D.H (ZHatOne (F D) Ω),
      ContH1.mk c = resZHat D (F D) (kummerZHat (F D) Ω u) ∧
        ∀ σ ∈ GaloisPi1.kernel D.H D.S, c σ = 1 := by
  obtain ⟨c, hc⟩ := ContH1.mk_surjective (resZHat D (F D) (kummerZHat (F D) Ω u))
  refine ⟨c, hc, fun σ hσ => Subtype.ext (funext fun i => ?_)⟩
  obtain ⟨c', hc', htriv⟩ := exists_trivial_kummer i.n u
  have hmk : ContH1.mk (ContH1.cocyclesMap (MonoidHom.id D.H) continuous_id (ZHatOne.proj i)
      (ZHatOne.continuous_proj i) (fun _ _ => rfl) c) = ContH1.mk c' := by
    rw [hc']
    refine Eq.trans ?_ (map_proj_res_kummerZHat i (u : (F D)ˣ))
    rw [← hc]
    rfl
  exact ContH1.trivial_on_of_mk_eq_mk hmk (kernel_smul_mu i.n) htriv σ hσ

variable (D) in
/-- **The Kummer map of `U`**, `κ_U : Γ(U, 𝒪^×) → H¹_cont(Π_U, Ẑ(1))` ([AbsTopIII] Prop. 1.6). -/
noncomputable def kummerMapZHat : units D →* ContH1 (Pi D) (ZHatOne (F D) Ω) :=
  ContH1.descendHom (fun _ _ => rfl)
    ((resZHat D (F D)).comp ((kummerZHat (F D) Ω).comp (units D).subtype))
    exists_trivial_kummerZHat

theorem inflation_kummerMapZHat (u : units D) :
    inflZHat D (F D) (kummerMapZHat D u) =
      resZHat D (F D) (kummerZHat (F D) Ω u) :=
  ContH1.inflation_descendHom _ _ _ u

/-- The `μ_n`-components of `κ_U` are the `μ_n`-valued Kummer maps. -/
theorem map_proj_kummerMapZHat (i : KummerIndex (F D)) (u : units D) :
    ContH1.map (MonoidHom.id (Pi D)) continuous_id (ZHatOne.proj i) (ZHatOne.continuous_proj i)
      (fun g x => proj_pi_smul i g x) (kummerMapZHat D u) = kummerMap D i.n u := by
  apply ContH1.inflation_injective (N := GaloisPi1.kernel D.H D.S) (fun _ _ => rfl)
  rw [inflation_kummerMap, ← map_proj_res_kummerZHat, ← inflation_kummerMapZHat]
  induction kummerMapZHat D u using ContH1.induction_on with
  | h c => rfl

/-- The function field `F` is finite over `k(t)`. -/
instance finiteDimensional_F : FiniteDimensional (K₀ k t) (F D) := by
  have e : (fixedField D.H).fixingSubgroup = D.H :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨D.H, D.isClosed_H⟩
  exact (InfiniteGalois.isOpen_iff_finite _).1 (by rw [e]; exact D.isOpen_H)

/-- **[AbsTopIII] Proposition 1.6(i): the Kummer map of `U` is injective** when `k` is
Kummer-faithful (for `𝔾_m`, Definition 1.5) and algebraically closed in the function field
(i.e. `U` is geometrically connected over `k`). -/
theorem kummerMapZHat_injective
    (hk : ∀ x : F D, IsAlgebraic k x → x ∈ Set.range (algebraMap k (F D)))
    (hkf : IsKummerFaithfulGm k) : Function.Injective (kummerMapZHat D) := by
  rw [injective_iff_map_eq_one]
  intro u hu
  have h1 : resZHat D (F D) (kummerZHat (F D) Ω u) = 1 := by
    rw [← inflation_kummerMapZHat, hu, map_one]
  have h2 : kummerZHat (F D) Ω u = 1 :=
    res_injective (M := ZHatOne (F D) Ω) (fun _ _ => rfl) (h1.trans (map_one _).symm)
  have hKF := isKummerFaithfulGm_of_finiteDimensional D.transcendental (F D) hk hkf
  refine Subtype.ext (hKF _ fun n hn => ?_)
  haveI : NeZero (n : F D) := ⟨Nat.cast_ne_zero.mpr hn.ne'⟩
  have h3 := h1Proj_kummerZHat (F D) Ω ⟨n, Nat.cast_ne_zero.mpr hn.ne'⟩ (u : (F D)ˣ)
  rw [h2, map_one] at h3
  have hker : (u : (F D)ˣ) ∈ (kummer n (F D) Ω).ker := h3.symm
  rw [ker_kummer] at hker
  obtain ⟨y, hy⟩ := hker
  exact ⟨y, hy⟩

end KummerMap

end Curve

